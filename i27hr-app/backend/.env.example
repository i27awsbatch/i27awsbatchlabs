# Copy the values you need into your shell / IDE run configuration before starting the backend.
# Spring Boot reads these via application.yml (${VAR:default} placeholders) — nothing is hardcoded.

# --- Database ---
DB_HOST=localhost
DB_PORT=3307
DB_NAME=i27corehr
DB_USERNAME=i27corehr
DB_PASSWORD=i27corehr_dev_pw

# --- Auth ---
# Any string 32+ bytes long. Generate a real secret for anything beyond local dev.
JWT_SECRET=change-this-dev-only-secret-key-please-override-in-prod-min-32-bytes
JWT_EXPIRATION_MS=28800000
JWT_REMEMBER_EXPIRATION_MS=1209600000

# --- CORS ---
# Comma-separated list of frontend origins allowed to call the API directly (not needed when
# using the Vite dev proxy).
CORS_ALLOWED_ORIGINS=http://localhost:5173

# --- Documents ---
# "local" works for local disk, an EC2 EBS-mounted path, or a shared EFS mount — they're all just
# filesystem paths to the application. Use "s3" to store documents in Amazon S3 instead (e.g. for
# ECS/Fargate, where there's no persistent local disk to share across tasks).
DOCUMENT_STORAGE_TYPE=local
DOCUMENT_LOCAL_PATH=./data/documents
# Required only when DOCUMENT_STORAGE_TYPE=s3. AWS credentials are NOT configured here — the AWS
# SDK's default credential provider chain is used (EC2/ECS role in AWS, your local AWS CLI
# profile/env vars if testing S3 mode locally).
DOCUMENT_S3_BUCKET=
DOCUMENT_S3_REGION=

# --- Server ---
SERVER_PORT=8080

# --- Demo data ---
# Seeds exactly 3 baseline accounts (HR Admin i27-0001, Manager i27-0002, Employee i27-0003) on
# first boot when the employees table is empty. Safe to leave on — it never touches data created
# afterwards. Set to false to disable seeding entirely (e.g. once you have real data).
SEED_DEMO_DATA=true
# Shared default login password: used for the 3 seeded accounts above AND for every employee
# HR Admin creates afterward, so there's one password across the whole local/demo environment.
SEED_DEFAULT_PASSWORD=Passw0rd!
